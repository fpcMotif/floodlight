# The pinned Zig toolchain version and release archive SHA-256 digests.
#
# Local and CI read this same file, so `make check` on a laptop and the check
# job on a pull request give the same verdict. Digests are the `shasum` values
# ziglang.org publishes in download/index.json.

NANOSPOT_ZIG_VERSION=0.17.0
NANOSPOT_ZIG_SHA256_MACOS_ARM64=b607e9b9234790a008116ae5bdb71c6243b84b9fb42a53a9e70fde41c06c536a
NANOSPOT_ZIG_SHA256_MACOS_X86_64=4f9a1c5269aa17ebda5e6d3c2b89d6cbf36f7d2b22a0306e9ab98f25f95529c6
NANOSPOT_ZIG_SHA256_LINUX_X86_64=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026
