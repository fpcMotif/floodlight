# The pinned version of every tool in the gate.
#
# Local and CI read this same file, so `make check` on a laptop and the check
# job on a pull request give the same verdict. An unpinned formatter is a
# formatting war; an unpinned linter is a build that goes red on a Tuesday
# because someone else's machine updated.
#
# Bumping a version is a deliberate commit: change the number here, run
# `make install-tools && make format && make check`, and land the resulting
# churn with it.

FLOODLIGHT_SWIFTLINT_VERSION=0.65.0
FLOODLIGHT_SWIFTFORMAT_VERSION=0.61.1
FLOODLIGHT_ASTGREP_VERSION=0.45.0
FLOODLIGHT_PERIPHERY_VERSION=3.8.0

# SHA-256 of each release archive, checked by scripts/install-tools.sh before
# anything is unpacked or made executable. A version number pins *which* release
# to ask for; only a digest pins what actually arrives. These are executables
# that then run over the whole source tree, so "downloaded from the right URL"
# is not the same claim as "is the artifact that was published".
#
# Regenerate after a version bump with:
#   curl -fsSL <url> | shasum -a 256
FLOODLIGHT_SWIFTLINT_SHA256=d6cb0aa7a2f5f1ef306fc9e37bcb54dc9a26facc8f7784ac0c3dd3eccf5c6ba6
FLOODLIGHT_SWIFTFORMAT_SHA256=b990400779aceb7d7020796eb9ba814d4480543f671d38fc0ff48cb72f04c584
FLOODLIGHT_ASTGREP_SHA256_ARM64=ec2e3680f4f84c68b48420bcca01d21389787c7318b52083dde6f46ac12ad946
FLOODLIGHT_ASTGREP_SHA256_X86_64=78d0d9db2f4dfd964fd313e70e92571c6d4204243ad8f3d0abbb2ffc56e45fc6
FLOODLIGHT_PERIPHERY_SHA256=07d4e286e31dd79164df39097e0b59f533c94badbe18158464a455ea88a166d7
