.DS_Store
.build/
.swiftpm/
# Pinned gate binaries, fetched by `make install-tools`. No trailing slash:
# with one, the pattern matches only a directory, and a `.tools` symlink —
# which is how you share one checkout's binaries with a second worktree —
# slips past it into a commit.
.tools
# Written by scripts/check-rules.sh to prove the rules are armed, and removed
# again on the way out. Ignored so an interrupted run cannot leave a file that
# looks like source.
Sources/*/GateSelfTest.swift
Tests/*/GateSelfTest.swift
DerivedData/
docs/.astro/
docs/dist/
docs/node_modules/
Floodlight.xcodeproj/xcuserdata/
*.xcuserstate
*.bc
