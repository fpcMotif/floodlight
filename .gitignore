.DS_Store
.build/
# Pinned Zig toolchain, fetched by `make install-zig`. No trailing slash so a
# `.tools` symlink shared across checkouts is ignored too.
.tools
docs/.astro/
docs/dist/
docs/node_modules/
docs/demo/node_modules/

# Local vendored checkouts.
Vendor/

# Zig build output for core/ and app/.
core/.zig-cache/
core/zig-out/
app/.zig-cache/
app/zig-out/
app/zig-pkg/

# Ephemeral agent/tool artifacts.
.scratch/
.hallmark/
.impeccable/
codedb.snapshot
