<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs floodlight-clipd at login, so copies are recorded while the TUI is
  closed. Install with:
    sed "s|@BIN@|$HOME/.local/bin|" com.floodlight.tui.clipd.plist > ~/Library/LaunchAgents/com.floodlight.tui.clipd.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.floodlight.tui.clipd.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.floodlight.tui.clipd</string>
    <key>ProgramArguments</key>
    <array>
        <string>@BIN@/floodlight-clipd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
