new file mode 100644
index 0000000..2eda22e
--- /dev/null
+++ b/Vendor/fff/crates/fff-test-harness/tests/contracts.rs
@@ -0,0 +1,138 @@
+use std::collections::BTreeSet;
+
+use fff_test_harness::{FixtureFile, MAX_LIMIT, SearchWorkload};
+use proptest::prelude::*;
+
+fn fixture() -> Vec<FixtureFile> {
+    [
+        "src/main.rs",
+        "src/nested/main.rs",
+        "docs/résumé guide.md",
+        "quotes/a'b\"c.txt",
+        "space name.txt",
+        "empty",
+    ]
+    .into_iter()
+    .map(|path| FixtureFile {
+        path: path.to_string(),
+        content: format!("fixture for {path}"),
+    })
+    .collect()
+}
+
+#[test]
+fn r01_results_are_bounded_unique_and_paginated() {
+    let mut workload = SearchWorkload::new().unwrap();
+    workload.init(&fixture(), false).unwrap();
+
+    let all = workload.query("", 0, MAX_LIMIT).unwrap();
+    let first = workload.query("", 0, 2).unwrap();
+    let second = workload.query("", 2, 2).unwrap();
+    let all_directories = workload.query_directories("", 0, MAX_LIMIT).unwrap();
+    let second_directory = workload.query_directories("", 1, 1).unwrap();
+    let identities = all
+        .items
+        .iter()
+        .map(|item| item.path.as_str())
+        .collect::<BTreeSet<_>>();
+
+    assert_eq!(all.items.len(), all.total_matched);
+    assert_eq!(identities.len(), all.items.len());
+    assert_eq!(first.items, all.items[0..2]);
+    assert_eq!(second.items, all.items[2..4]);
+    assert!(!all_directories.items.is_empty());
+    assert_eq!(second_directory.items, all_directories.items[1..2]);
+    assert!(
+        all.items
+            .iter()
+            .all(|item| workload.root().join(&item.path).is_file())
+    );
+    assert!(
+        workload
+            .query("résumé", 0, 4)
+            .unwrap()
+            .items
+            .iter()
+            .any(|item| item.path == "docs/résumé guide.md")
+    );
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig::with_cases(24))]
+
+    #[test]
+    fn r01_pages_match_the_same_real_search(
+        offset in 0usize..10,
+        limit in 0usize..12,
+        query in prop::sample::select(vec!["", "main", "résumé", "space", "a'b\"c"])
+    ) {
+        let mut workload = SearchWorkload::new().unwrap();
+        workload.init(&fixture(), false).unwrap();
+        let all = workload.query(query, 0, MAX_LIMIT).unwrap();
+        let page = workload.query(query, offset, limit).unwrap();
+        let effective_limit = if limit == 0 { all.items.len() } else { limit };
+        let end = offset.saturating_add(effective_limit).min(all.items.len());
+        let expected = if offset < all.items.len() { &all.items[offset..end] } else { &[] };
+
+        prop_assert!(limit == 0 || page.items.len() <= limit);
+        prop_assert!(page.items.iter().all(|item| workload.root().join(&item.path).is_file()));
+        prop_assert_eq!(&page.items, expected);
+        prop_assert_eq!(page.total_matched, all.total_matched);
+    }
+
+    #[test]
+    fn r03_bounded_filesystem_lifecycle_converges(
+        operations in prop::collection::vec((0u8..5, 0usize..8), 1..20)
+    ) {
+        let mut workload = SearchWorkload::new().unwrap();
+        workload.init(&[], false).unwrap();
+        let mut expected = BTreeSet::new();
+
+        for (kind, slot) in operations {
+            let path = format!("generated/item-{slot}.txt");
+            let renamed = format!("renamed/item-{slot}.txt");
+            match kind {
+                0 => {
+                    workload.put(&path, &format!("value {slot}")).unwrap();
+                    expected.insert(path);
+                }
+                1 => {
+                    workload.remove(&path).unwrap();
+                    expected.remove(&path);
+                }
+                2 if expected.contains(&path) => {
+                    workload.rename(&path, &renamed).unwrap();
+                    expected.remove(&path);
+                    expected.insert(renamed);
+                }
+                3 => {
+                    let files = expected
+                        .iter()
+                        .map(|path| FixtureFile {
+                            path: path.clone(),
+                            content: "restored".to_string(),
+                        })
+                        .collect::<Vec<_>>();
+                    workload.shutdown();
+                    workload.init(&files, false).unwrap();
+                }
+                _ => {
+                    workload.rebuild().unwrap();
+                    workload.quiesce(10_000).unwrap();
+                }
+            }
+        }
+
+        workload.rebuild().unwrap();
+        let observation = workload.quiesce(10_000).unwrap();
+        let found = workload
+            .query("", 0, MAX_LIMIT)
+            .unwrap()
+            .items
+            .into_iter()
+            .map(|item| item.path)
+            .collect::<BTreeSet<_>>();
+        prop_assert!(!observation.scanning);
+        prop_assert_eq!(found, expected);
+    }
+}
