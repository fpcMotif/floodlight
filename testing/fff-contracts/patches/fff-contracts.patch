+++ b/Vendor/fff/crates/fff-test-harness/src/lib.rs
@@ -0,0 +1,358 @@
+use std::fs;
+use std::path::{Component, Path, PathBuf};
+use std::time::Duration;
+
+use fff_search::{
+    FFFMode, FilePicker, FilePickerOptions, FuzzySearchOptions, PaginationArgs, QueryParser,
+    SharedFilePicker, SharedFrecency,
+};
+use serde::{Deserialize, Serialize};
+use tempfile::TempDir;
+
+pub const MAX_CONTENT_BYTES: usize = 64 * 1024;
+pub const MAX_FIXTURE_FILES: usize = 256;
+pub const MAX_LIMIT: usize = 100;
+pub const MAX_PATH_BYTES: usize = 512;
+pub const MAX_QUERY_BYTES: usize = 512;
+pub const MAX_TIMEOUT_MS: u64 = 10_000;
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+pub struct FixtureFile {
+    pub path: String,
+    #[serde(default)]
+    pub content: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub struct SearchItem {
+    pub path: String,
+    pub file_name: String,
+    pub score: i32,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub struct SearchPage {
+    pub items: Vec<SearchItem>,
+    pub total_matched: usize,
+    pub total_files: usize,
+    pub offset: usize,
+    pub limit: usize,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub struct Observation {
+    pub initialized: bool,
+    pub root: String,
+    pub live_files: usize,
+    pub scanned_files: usize,
+    pub scanning: bool,
+    pub watcher_ready: bool,
+    pub generation: u64,
+}
+
+pub struct SearchWorkload {
+    fixture: TempDir,
+    picker: SharedFilePicker,
+    frecency: SharedFrecency,
+    initialized: bool,
+    watch: bool,
+    generation: u64,
+}
+
+impl SearchWorkload {
+    pub fn new() -> Result<Self, String> {
+        Ok(Self {
+            fixture: tempfile::tempdir().map_err(|error| error.to_string())?,
+            picker: SharedFilePicker::default(),
+            frecency: SharedFrecency::noop(),
+            initialized: false,
+            watch: false,
+            generation: 0,
+        })
+    }
+
+    pub fn init(&mut self, files: &[FixtureFile], watch: bool) -> Result<Observation, String> {
+        if files.len() > MAX_FIXTURE_FILES {
+            return Err(format!("fixture exceeds {MAX_FIXTURE_FILES} files"));
+        }
+        self.shutdown();
+        self.clear_fixture()?;
+        for file in files {
+            self.write_fixture(&file.path, &file.content)?;
+        }
+
+        self.picker = SharedFilePicker::default();
+        self.frecency = SharedFrecency::noop();
+        FilePicker::new_with_shared_state(
+            self.picker.clone(),
+            self.frecency.clone(),
+            FilePickerOptions {
+                base_path: self.root().to_string_lossy().into_owned(),
+                mode: FFFMode::Ai,
+                watch,
+                enable_content_indexing: false,
+                enable_mmap_cache: false,
+                ..Default::default()
+            },
+        )
+        .map_err(|error| error.to_string())?;
+        self.initialized = true;
+        self.watch = watch;
+        self.generation += 1;
+        self.quiesce(MAX_TIMEOUT_MS)
+    }
+
+    pub fn query(&self, query: &str, offset: usize, limit: usize) -> Result<SearchPage, String> {
+        if query.len() > MAX_QUERY_BYTES {
+            return Err(format!("query exceeds {MAX_QUERY_BYTES} bytes"));
+        }
+        if limit > MAX_LIMIT {
+            return Err(format!("limit exceeds {MAX_LIMIT}"));
+        }
+        let offset = offset.min(MAX_FIXTURE_FILES);
+        let guard = self.picker.read().map_err(|error| error.to_string())?;
+        let picker = guard.as_ref().ok_or("workload is not initialized")?;
+        let parsed = QueryParser::default().parse(query);
+        let results = picker.fuzzy_search(
+            &parsed,
+            None,
+            FuzzySearchOptions {
+                max_threads: 1,
+                pagination: PaginationArgs { offset, limit },
+                ..Default::default()
+            },
+        );
+        let items = results
+            .items
+            .iter()
+            .zip(&results.scores)
+            .map(|(item, score)| SearchItem {
+                path: item.relative_path(picker),
+                file_name: item.file_name(picker),
+                score: score.total,
+            })
+            .collect();
+        Ok(SearchPage {
+            items,
+            total_matched: results.total_matched,
+            total_files: results.total_files,
+            offset,
+            limit,
+        })
+    }
+
+    pub fn query_directories(
+        &self,
+        query: &str,
+        offset: usize,
+        limit: usize,
+    ) -> Result<SearchPage, String> {
+        if query.len() > MAX_QUERY_BYTES {
+            return Err(format!("query exceeds {MAX_QUERY_BYTES} bytes"));
+        }
+        if limit > MAX_LIMIT {
+            return Err(format!("limit exceeds {MAX_LIMIT}"));
+        }
+        let offset = offset.min(MAX_FIXTURE_FILES);
+        let guard = self.picker.read().map_err(|error| error.to_string())?;
+        let picker = guard.as_ref().ok_or("workload is not initialized")?;
+        let parsed = QueryParser::default().parse(query);
+        let results = picker.fuzzy_search_directories(
+            &parsed,
+            FuzzySearchOptions {
+                max_threads: 1,
+                pagination: PaginationArgs { offset, limit },
+                ..Default::default()
+            },
+        );
+        let items = results
+            .items
+            .iter()
+            .zip(&results.scores)
+            .map(|(item, score)| {
+                let path = item.relative_path(picker);
+                SearchItem {
+                    file_name: path
+                        .trim_end_matches('/')
+                        .rsplit('/')
+                        .next()
+                        .unwrap_or("")
+                        .to_string(),
+                    path,
+                    score: score.total,
+                }
+            })
+            .collect();
+        Ok(SearchPage {
+            items,
+            total_matched: results.total_matched,
+            total_files: results.total_dirs,
+            offset,
+            limit,
+        })
+    }
+
+    pub fn put(&mut self, path: &str, content: &str) -> Result<Observation, String> {
+        self.ensure_initialized()?;
+        let absolute = self.write_fixture(path, content)?;
+        let mut guard = self.picker.write().map_err(|error| error.to_string())?;
+        let picker = guard.as_mut().ok_or("workload is not initialized")?;
+        picker
+            .handle_create_or_modify(&absolute)
+            .ok_or_else(|| "index rejected put; rebuild required".to_string())?;
+        drop(guard);
+        self.generation += 1;
+        self.observe()
+    }
+
+    pub fn remove(&mut self, path: &str) -> Result<Observation, String> {
+        self.ensure_initialized()?;
+        let absolute = self.resolve_path(path)?;
+        match fs::remove_file(&absolute) {
+            Ok(()) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error.to_string()),
+        }
+        let mut guard = self.picker.write().map_err(|error| error.to_string())?;
+        let picker = guard.as_mut().ok_or("workload is not initialized")?;
+        picker.remove_file_by_path(&absolute);
+        drop(guard);
+        self.generation += 1;
+        self.observe()
+    }
+
+    pub fn rename(&mut self, from: &str, to: &str) -> Result<Observation, String> {
+        self.ensure_initialized()?;
+        let source = self.resolve_path(from)?;
+        let destination = self.resolve_path(to)?;
+        if let Some(parent) = destination.parent() {
+            fs::create_dir_all(parent).map_err(|error| error.to_string())?;
+        }
+        fs::rename(&source, &destination).map_err(|error| error.to_string())?;
+        let mut guard = self.picker.write().map_err(|error| error.to_string())?;
+        let picker = guard.as_mut().ok_or("workload is not initialized")?;
+        picker.remove_file_by_path(&source);
+        picker
+            .handle_create_or_modify(&destination)
+            .ok_or_else(|| "index rejected rename; rebuild required".to_string())?;
+        drop(guard);
+        self.generation += 1;
+        self.observe()
+    }
+
+    pub fn rebuild(&mut self) -> Result<Observation, String> {
+        self.ensure_initialized()?;
+        self.picker
+            .trigger_full_rescan_async(&self.frecency)
+            .map_err(|error| error.to_string())?;
+        self.generation += 1;
+        self.observe()
+    }
+
+    pub fn quiesce(&self, timeout_ms: u64) -> Result<Observation, String> {
+        self.ensure_initialized()?;
+        let timeout = Duration::from_millis(timeout_ms.min(MAX_TIMEOUT_MS));
+        if !self.picker.wait_for_indexing_complete(timeout) {
+            return Err("index did not quiesce before timeout".to_string());
+        }
+        if self.watch && !self.picker.wait_for_watcher(timeout) {
+            return Err("watcher was not ready before timeout".to_string());
+        }
+        self.observe()
+    }
+
+    pub fn observe(&self) -> Result<Observation, String> {
+        let root = self.root().to_string_lossy().into_owned();
+        if !self.initialized {
+            return Ok(Observation {
+                initialized: false,
+                root,
+                live_files: 0,
+                scanned_files: 0,
+                scanning: false,
+                watcher_ready: false,
+                generation: self.generation,
+            });
+        }
+        let guard = self.picker.read().map_err(|error| error.to_string())?;
+        let picker = guard.as_ref().ok_or("workload is not initialized")?;
+        let progress = picker.get_scan_progress();
+        Ok(Observation {
+            initialized: true,
+            root,
+            live_files: picker.live_file_count(),
+            scanned_files: progress.scanned_files_count,
+            scanning: progress.is_scanning || picker.is_post_scan_active(),
+            watcher_ready: progress.is_watcher_ready,
+            generation: self.generation,
+        })
+    }
+
+    pub fn shutdown(&mut self) {
+        self.picker.shutdown_watches_and_wait();
+        if let Ok(mut guard) = self.picker.write()
+            && let Some(mut picker) = guard.take()
+        {
+            picker.stop_background_monitor();
+        }
+        self.initialized = false;
+        self.watch = false;
+    }
+
+    pub fn root(&self) -> &Path {
+        self.fixture.path()
+    }
+
+    fn clear_fixture(&self) -> Result<(), String> {
+        for entry in fs::read_dir(self.root()).map_err(|error| error.to_string())? {
+            let path = entry.map_err(|error| error.to_string())?.path();
+            if path.is_dir() {
+                fs::remove_dir_all(path).map_err(|error| error.to_string())?;
+            } else {
+                fs::remove_file(path).map_err(|error| error.to_string())?;
+            }
+        }
+        Ok(())
+    }
+
+    fn ensure_initialized(&self) -> Result<(), String> {
+        if self.initialized {
+            Ok(())
+        } else {
+            Err("workload is not initialized".to_string())
+        }
+    }
+
+    fn resolve_path(&self, path: &str) -> Result<PathBuf, String> {
+        if path.is_empty() || path.len() > MAX_PATH_BYTES {
+            return Err(format!("path must contain 1..={MAX_PATH_BYTES} bytes"));
+        }
+        let path = Path::new(path);
+        if path.is_absolute()
+            || path
+                .components()
+                .any(|part| !matches!(part, Component::Normal(_)))
+        {
+            return Err("path must be a plain relative path".to_string());
+        }
+        Ok(self.root().join(path))
+    }
+
+    fn write_fixture(&self, path: &str, content: &str) -> Result<PathBuf, String> {
+        if content.len() > MAX_CONTENT_BYTES {
+            return Err(format!("content exceeds {MAX_CONTENT_BYTES} bytes"));
+        }
+        let absolute = self.resolve_path(path)?;
+        if let Some(parent) = absolute.parent() {
+            fs::create_dir_all(parent).map_err(|error| error.to_string())?;
+        }
+        fs::write(&absolute, content).map_err(|error| error.to_string())?;
+        Ok(absolute)
+    }
+}
+
+impl Drop for SearchWorkload {
+    fn drop(&mut self) {
+        self.shutdown();
+    }
+}
