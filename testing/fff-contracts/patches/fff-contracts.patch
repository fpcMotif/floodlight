@@ -0,0 +1,51 @@
+use std::io::Write;
+use std::process::{Command, Stdio};
+
+use serde_json::Value;
+
+#[test]
+fn terminal_protocol_marks_ready_and_correlates_every_operation() {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_fff-terminal-harness"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .spawn()
+        .unwrap();
+    let input = [
+        r#"{"id":"init","op":"init","files":[{"path":"alpha.txt","content":"a"}]}"#,
+        r#"{"id":"query","op":"query","query":"alpha","offset":0,"limit":5}"#,
+        r#"{"id":"put","op":"put","path":"beta.txt","content":"b"}"#,
+        r#"{"id":"rename","op":"rename","from":"beta.txt","to":"gamma.txt"}"#,
+        r#"{"id":"remove","op":"remove","path":"gamma.txt"}"#,
+        r#"{"id":"rebuild","op":"rebuild"}"#,
+        r#"{"id":"quiesce","op":"quiesce","timeout_ms":10000}"#,
+        r#"{"id":"observe","op":"observe"}"#,
+        r#"{"id":"shutdown","op":"shutdown"}"#,
+    ]
+    .into_iter()
+    .map(|line| format!("\u{1b}[200~{line}\n\u{1b}[201~"))
+    .collect::<String>();
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(input.as_bytes())
+        .unwrap();
+
+    let output = child.wait_with_output().unwrap();
+    assert!(output.status.success());
+    let lines = String::from_utf8(output.stdout).unwrap();
+    let messages = lines
+        .lines()
+        .map(|line| serde_json::from_str::<Value>(line).unwrap())
+        .collect::<Vec<_>>();
+
+    assert_eq!(messages.len(), 10);
+    assert_eq!(messages[0]["type"], "ready");
+    assert_eq!(messages[0]["ready"], true);
+    for (message, id) in messages[1..].iter().zip([
+        "init", "query", "put", "rename", "remove", "rebuild", "quiesce", "observe", "shutdown",
+    ]) {
+        assert_eq!(message["id"], id);
+        assert_eq!(message["ok"], true, "{message}");
+    }
+}
