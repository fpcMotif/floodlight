diff --git a/Vendor/fff/crates/fff-test-harness/src/bin/fff-test-terminal.rs b/Vendor/fff/crates/fff-test-harness/src/bin/fff-test-terminal.rs
new file mode 100644
index 0000000..85d30bf
--- /dev/null
+++ b/Vendor/fff/crates/fff-test-harness/src/bin/fff-test-terminal.rs
@@ -0,0 +1,262 @@
+use std::io::{self, BufRead, IsTerminal, Write};
+
+use fff_test_harness::{FixtureFile, MAX_TIMEOUT_MS, SearchWorkload};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+const MAX_COMMANDS: usize = 10_000;
+const MAX_ERROR_BYTES: usize = 512;
+const MAX_LINE_BYTES: usize = 1024 * 1024;
+
+#[derive(Deserialize)]
+#[serde(tag = "op", rename_all = "snake_case")]
+enum Command {
+    Init {
+        id: String,
+        #[serde(default)]
+        files: Vec<FixtureFile>,
+        #[serde(default)]
+        watch: bool,
+    },
+    Query {
+        id: String,
+        #[serde(default)]
+        query: String,
+        #[serde(default)]
+        offset: usize,
+        limit: usize,
+    },
+    Put {
+        id: String,
+        path: String,
+        #[serde(default)]
+        content: String,
+    },
+    Remove {
+        id: String,
+        path: String,
+    },
+    Rename {
+        id: String,
+        from: String,
+        to: String,
+    },
+    Rebuild {
+        id: String,
+    },
+    Quiesce {
+        id: String,
+        #[serde(default = "default_timeout")]
+        timeout_ms: u64,
+    },
+    Observe {
+        id: String,
+    },
+    Shutdown {
+        id: String,
+    },
+}
+
+fn main() {
+    let _echo = EchoGuard::disable();
+    let mut output = io::stdout().lock();
+    let mut workload = match SearchWorkload::new() {
+        Ok(workload) => workload,
+        Err(error) => {
+            emit(&mut output, failure("startup", "startup", &error));
+            return;
+        }
+    };
+    if let Err(error) = workload.init(&[], false) {
+        emit(&mut output, failure("startup", "startup", &error));
+        return;
+    }
+    emit(
+        &mut output,
+        json!({"type":"ready","ready":true,"protocol":1}),
+    );
+
+    for line in io::stdin().lock().lines().take(MAX_COMMANDS) {
+        let line = match line {
+            Ok(line) if line.len() <= MAX_LINE_BYTES => line,
+            Ok(_) => {
+                emit(
+                    &mut output,
+                    failure("invalid", "invalid", "command line is too large"),
+                );
+                continue;
+            }
+            Err(error) => {
+                emit(
+                    &mut output,
+                    failure("invalid", "invalid", &error.to_string()),
+                );
+                break;
+            }
+        };
+        let line = line.replace("\u{1b}[200~", "").replace("\u{1b}[201~", "");
+        if line.is_empty() {
+            continue;
+        }
+        let value: Value = match serde_json::from_str(&line) {
+            Ok(value) => value,
+            Err(error) => {
+                emit(
+                    &mut output,
+                    failure("invalid", "invalid", &error.to_string()),
+                );
+                continue;
+            }
+        };
+        let fallback_id = value
+            .get("id")
+            .and_then(Value::as_str)
+            .unwrap_or("invalid")
+            .chars()
+            .take(128)
+            .collect::<String>();
+        if value
+            .get("id")
+            .and_then(Value::as_str)
+            .is_some_and(|id| id.len() > 128)
+        {
+            emit(
+                &mut output,
+                failure(&fallback_id, "invalid", "command id exceeds 128 bytes"),
+            );
+            continue;
+        }
+        let command: Command = match serde_json::from_value(value) {
+            Ok(command) => command,
+            Err(error) => {
+                emit(
+                    &mut output,
+                    failure(&fallback_id, "invalid", &error.to_string()),
+                );
+                continue;
+            }
+        };
+        let shutdown = matches!(command, Command::Shutdown { .. });
+        emit(&mut output, execute(&mut workload, command));
+        if shutdown {
+            break;
+        }
+    }
+}
+
+fn execute(workload: &mut SearchWorkload, command: Command) -> Value {
+    let (id, op, result) = match command {
+        Command::Init { id, files, watch } => {
+            let result = workload.init(&files, watch).and_then(to_value);
+            (id, "init", result)
+        }
+        Command::Query {
+            id,
+            query,
+            offset,
+            limit,
+        } => {
+            let result = workload.query(&query, offset, limit).and_then(to_value);
+            (id, "query", result)
+        }
+        Command::Put { id, path, content } => {
+            let result = workload.put(&path, &content).and_then(to_value);
+            (id, "put", result)
+        }
+        Command::Remove { id, path } => {
+            let result = workload.remove(&path).and_then(to_value);
+            (id, "remove", result)
+        }
+        Command::Rename { id, from, to } => {
+            let result = workload.rename(&from, &to).and_then(to_value);
+            (id, "rename", result)
+        }
+        Command::Rebuild { id } => {
+            let result = workload
+                .rebuild()
+                .and_then(|_| workload.quiesce(MAX_TIMEOUT_MS))
+                .and_then(to_value);
+            (id, "rebuild", result)
+        }
+        Command::Quiesce { id, timeout_ms } => {
+            let result = workload.quiesce(timeout_ms).and_then(to_value);
+            (id, "quiesce", result)
+        }
+        Command::Observe { id } => {
+            let result = workload.observe().and_then(to_value);
+            (id, "observe", result)
+        }
+        Command::Shutdown { id } => {
+            workload.shutdown();
+            (id, "shutdown", Ok(json!({"shutdown":true})))
+        }
+    };
+    match result {
+        Ok(data) => json!({"type":"result","id":id,"op":op,"ok":true,"data":data}),
+        Err(error) => failure(&id, op, &error),
+    }
+}
+
+fn to_value(value: impl serde::Serialize) -> Result<Value, String> {
+    serde_json::to_value(value).map_err(|error| error.to_string())
+}
+
+fn failure(id: &str, op: &str, error: &str) -> Value {
+    let error = error.chars().take(MAX_ERROR_BYTES).collect::<String>();
+    json!({"type":"result","id":id,"op":op,"ok":false,"error":error})
+}
+
+fn emit(output: &mut impl Write, value: Value) {
+    let _ = serde_json::to_writer(&mut *output, &value);
+    let _ = output.write_all(b"\n");
+    let _ = output.flush();
+}
+
+fn default_timeout() -> u64 {
+    MAX_TIMEOUT_MS
+}
+
+#[cfg(unix)]
+struct EchoGuard(Option<libc::termios>);
+
+#[cfg(unix)]
+impl EchoGuard {
+    fn disable() -> Self {
+        if !io::stdin().is_terminal() {
+            return Self(None);
+        }
+        unsafe {
+            let mut original = std::mem::zeroed();
+            if libc::tcgetattr(libc::STDIN_FILENO, &mut original) != 0 {
+                return Self(None);
+            }
+            let mut quiet = original;
+            quiet.c_lflag &= !libc::ECHO;
+            if libc::tcsetattr(libc::STDIN_FILENO, libc::TCSANOW, &quiet) != 0 {
+                return Self(None);
+            }
+            Self(Some(original))
+        }
+    }
+}
+
+#[cfg(unix)]
+impl Drop for EchoGuard {
+    fn drop(&mut self) {
+        if let Some(original) = self.0 {
+            unsafe {
+                libc::tcsetattr(libc::STDIN_FILENO, libc::TCSANOW, &original);
+            }
+        }
+    }
+}
+
+#[cfg(not(unix))]
+struct EchoGuard;
+
+#[cfg(not(unix))]
+impl EchoGuard {
+    fn disable() -> Self {
+        Self
+    }
+}
diff --git a/Vendor/fff/crates/fff-test-harness/src/lib.rs b/Vendor/fff/crates/fff-test-harness/src/lib.rs
