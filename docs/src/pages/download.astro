---
import { Image } from "astro:assets";
import Landing from "../layouts/Landing.astro";
import DownloadButton from "../components/DownloadButton.astro";
import listDark from "../assets/screenshots/panel-list-dark.png";
import listLight from "../assets/screenshots/panel-list-light.png";
import boardDark from "../assets/screenshots/panel-board-dark.png";
import boardLight from "../assets/screenshots/panel-board-light.png";
import "../styles/download.css";

const base = import.meta.env.BASE_URL;
const root = `${base.replace(/\/$/, "")}/`;
const docs = (slug: string) => `${root}${slug}/`;
---

<Landing
  title="Download Nanospot for Mac"
  description="Download Nanospot.dmg, the fast, native, open-source Spotlight alternative for macOS. Search apps, files, and your clipboard history from one panel."
>
  <div class="dl">
    <header class="dl-hero">
      <div class="wrap wrap--wide dl-hero__grid">
        <div class="dl-hero__copy">
          <h1 class="h1">Download Nanospot</h1>
          <p class="lede">Find apps, files, and everything you copied from one panel.</p>
          <div class="dl-actions">
            <DownloadButton label="Download Nanospot.dmg" />
            <a class="link" href={docs("development/building")}>Build from source</a>
          </div>
          <p class="fine">1.5 MB binary · 3.1 MB app · macOS 14+ · Apple silicon</p>
        </div>

        <div class="dl-hero__stage" data-ss-fill>
          <div
            class="dl-demo"
            data-nanospot-demo
            role="img"
            aria-label="Nanospot answering the query cal, then opening the clipboard board."
          >
            <Image
              src={listDark}
              alt=""
              widths={[760, 1520]}
              sizes="(min-width: 72rem) 55vw, 100vw"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </header>

    <section class="dl-sec" aria-labelledby="dl-dark">
      <div class="wrap wrap--wide">
        <div class="dl-copy">
          <h2 class="h2" id="dl-dark">Search and clipboard, native to macOS</h2>
          <p>
            Apps, files, folders, and settings rank in one list on <kbd class="dl-kbd" aria-hidden="true">⌥Space</kbd><span class="sr-only">Option Space</span>.
            <kbd class="dl-kbd" aria-hidden="true">⌥⇧C</kbd><span class="sr-only">Option Shift C</span> opens the split clipboard board.
          </p>
        </div>
        <div class="dl-pair">
          <figure class="dl-figure">
            <Image
              class="dl-shot"
              src={listDark}
              alt="The Nanospot panel showing results for the query cal, with Calendar as the top hit."
              widths={[600, 1200, 1520]}
              sizes="(min-width: 46rem) 45vw, 100vw"
            />
            <figcaption>Search panel — ranked apps and files</figcaption>
          </figure>
          <figure class="dl-figure">
            <Image
              class="dl-shot"
              src={boardDark}
              alt="The Nanospot clipboard board: copied entries on the left and a preview of the selected entry on the right."
              widths={[600, 1200, 1520]}
              sizes="(min-width: 46rem) 45vw, 100vw"
            />
            <figcaption>Clipboard board — ⌥⇧C history with live inspector</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="dl-sec dl-sec--light" aria-labelledby="dl-light">
      <div class="wrap wrap--wide">
        <div class="dl-copy">
          <h2 class="h2" id="dl-light">Light when your Mac is</h2>
          <p>The panel follows the macOS appearance.</p>
        </div>
        <div class="dl-pair">
          <figure class="dl-figure">
            <Image
              class="dl-shot"
              src={listLight}
              alt="The search panel in the light appearance."
              widths={[600, 1200, 1520]}
              sizes="(min-width: 46rem) 45vw, 100vw"
            />
            <figcaption>Search panel — light appearance</figcaption>
          </figure>
          <figure class="dl-figure">
            <Image
              class="dl-shot"
              src={boardLight}
              alt="The clipboard board in the light appearance."
              widths={[600, 1200, 1520]}
              sizes="(min-width: 46rem) 45vw, 100vw"
            />
            <figcaption>Clipboard board — light appearance</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="dl-sec" aria-labelledby="dl-install">
      <div class="wrap wrap--wide dl-install">
        <div>
          <h2 class="h2" id="dl-install">Install in four steps</h2>
          <ol class="dl-steps" role="list">
            <li>Open Nanospot.dmg.</li>
            <li>Drag Nanospot to Applications.</li>
            <li>Eject the Nanospot disk image.</li>
            <li>Open Nanospot from Applications.</li>
          </ol>
        </div>
        <div class="dl-needs">
          <h3>What you need</h3>
          <ul>
            <li>An Apple-silicon Mac</li>
            <li>macOS 14 Sonoma or later</li>
            <li>4 MB of free disk space (3.1 MB app, 1.5 MB binary)</li>
          </ul>
          <DownloadButton label="Download Nanospot.dmg" />
          <a class="dl-link" href={docs("getting-started/install")}>Install and permissions guide</a>
        </div>
      </div>
    </section>
  </div>

  <link rel="stylesheet" href={`${root}demo/demo.css`} />
  <script is:inline type="module" src={`${root}demo/demo.js`}></script>
</Landing>
