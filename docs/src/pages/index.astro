---
import Landing from "../layouts/Landing.astro";
import FloodlightPanel from "../components/FloodlightPanel.astro";
import DownloadButton from "../components/DownloadButton.astro";

const base = import.meta.env.BASE_URL;
const root = `${base.replace(/\/$/, "")}/`;
const docs = (slug: string) => `${root}${slug}/`;
---

<Landing
  title="Floodlight — a fast, native Spotlight alternative for macOS"
  description="Floodlight is a fast, native, open-source Spotlight alternative. It finds apps, files, folders, and settings from one keyboard-first panel and keeps every index on your Mac."
>
  <header class="hero">
    <div class="wrap wrap--wide hero__copy">
      <h1 class="h1">Fast local search on Mac</h1>
      <p class="lede">A fast, native, open-source Spotlight alternative.</p>
      <div class="cta-row">
        <DownloadButton />
        <a class="btn btn--ghost btn--glass" href={docs("getting-started/quickstart")}>
          Read the docs <span class="btn__arrow" aria-hidden="true">›</span>
        </a>
      </div>
      <div class="hero__meta">
        <p class="fine">macOS 14 or later · Apple silicon · MIT</p>
        <p class="credit">
          Created by <a href="https://vmg.dev" rel="author">Victor Garcia</a>
          <a
            class="credit__social"
            href="https://x.com/vmg__0"
            rel="me"
            aria-label="Victor Garcia on X"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M18.9 2h3.68l-8.04 9.19L24 23.7h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 2h7.59l5.24 6.93L18.9 2Zm-1.29 19.5h2.04L6.48 4.08H4.29L17.61 21.5Z"
              />
            </svg>
          </a>
        </p>
      </div>
    </div>

    <div class="hero__stage">
      <div class="stage">
        <div class="stage__light" data-light aria-hidden="true">
          <span class="stage__beam"></span>
          <span class="stage__flare"></span>
        </div>
        <FloodlightPanel />
      </div>

      <ul class="claims">
        <li>
          <span class="claims__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m12 14 4-4"></path>
              <path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
            </svg>
          </span>
          <span class="claims__copy">
            <span class="claims__lead">Instant results</span>
            <span>Results in less than a millisecond</span>
          </span>
        </li>
        <li>
          <span class="claims__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 4.1 12 6"></path>
              <path d="m5.1 8-2.9-.8"></path>
              <path d="m6 12-1.9 2"></path>
              <path d="M7.2 2.2 8 5.1"></path>
              <path
                d="M9.037 9.69a.498.498 0 0 1 .653-.653l11 4.5a.5.5 0 0 1-.074.949l-4.349 1.041a1 1 0 0 0-.74.739l-1.04 4.35a.5.5 0 0 1-.95.074z"
              ></path>
            </svg>
          </span>
          <span class="claims__copy">
            <span class="claims__lead">Stop clicking the wrong thing</span>
            <span>Your selection stays put</span>
          </span>
        </li>
        <li>
          <span class="claims__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 22V12"></path>
              <path d="m16 17 2 2 4-4"></path>
              <path
                d="M21 11.127V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.729l7 4a2 2 0 0 0 2 .001l1.32-.753"
              ></path>
              <path d="M3.29 7 12 12l8.71-5"></path>
              <path d="m7.5 4.27 8.997 5.148"></path>
            </svg>
          </span>
          <span class="claims__copy">
            <span class="claims__lead">Small install size</span>
            <span>6.2 MB binary</span>
          </span>
        </li>
        <li>
          <span class="claims__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
              <path d="m8 11 2 2 4-4"></path>
            </svg>
          </span>
          <span class="claims__copy">
            <span class="claims__lead">Just search</span>
            <span>No bundled JS, no cloud, no ads</span>
          </span>
        </li>
      </ul>
    </div>
  </header>
</Landing>
