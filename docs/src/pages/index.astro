---
import Landing from "../layouts/Landing.astro";
import NanospotPanel from "../components/NanospotPanel.astro";
import DownloadButton from "../components/DownloadButton.astro";
import BoardScene from "../components/BoardScene.astro";

const base = import.meta.env.BASE_URL;
const root = `${base.replace(/\/$/, "")}/`;
const docs = (slug: string) => `${root}${slug}/`;
---

<Landing
  title="Nanospot — a fast, native Spotlight alternative for macOS"
  description="Nanospot is a fast, native, open-source Spotlight alternative. It finds apps, files, folders, and settings from one keyboard-first panel and keeps every index on your Mac."
>
  <header class="hero">
    <div class="wrap wrap--wide hero__grid">
      <div class="hero__copy">
        <h1 class="h1">Local search for Mac, built in Zig.</h1>
        <p class="lede">
          Press <kbd class="clip__kbd">⌥Space</kbd> for apps and files, or
          <kbd class="clip__kbd">⌥⇧C</kbd> for clipboard history. Every index stays on your Mac.
        </p>
        <div class="cta-row">
          <DownloadButton label="Download Nanospot.dmg" />
          <a class="link" href={docs("getting-started/quickstart")}>Read the docs</a>
        </div>
        <div class="hero__meta">
          <p class="fine">1.5 MB binary · macOS 14+ · Apple silicon · MIT</p>
          <p class="credit">
            Created by <a href="https://vmg.dev" rel="author">Victor Garcia</a>
          </p>
        </div>
      </div>

      <div class="hero__stage">
        <div class="stage">
          <NanospotPanel />
        </div>
      </div>
    </div>
  </header>

  <section class="specs-band" aria-label="Measured characteristics">
    <div class="wrap wrap--wide">
      <dl class="specs">
        <div class="specs__item">
          <dt class="specs__val">1.5 MB</dt>
          <dd class="specs__desc">Single Zig binary. No Electron, no web view.</dd>
        </div>
        <div class="specs__item">
          <dt class="specs__val">&lt; 1 ms</dt>
          <dd class="specs__desc">Memory-mapped file index, ranked in memory.</dd>
        </div>
        <div class="specs__item">
          <dt class="specs__val">0 ms</dt>
          <dd class="specs__desc">Instant panel toggle and arrow navigation.</dd>
        </div>
        <div class="specs__item">
          <dt class="specs__val">Local</dt>
          <dd class="specs__desc">Index and clipboard history stay on disk.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="clip" aria-labelledby="clip-title">
    <div class="wrap wrap--wide clip__copy">
      <h2 class="h2" id="clip-title">Your clipboard, searchable offline</h2>
      <p class="lede">
        <kbd class="clip__kbd">⌥⇧C</kbd> opens text, links, colors, code, and files in one split board.
        Password managers are skipped.
      </p>
    </div>
    <div class="wrap wrap--wide">
      <BoardScene />
    </div>
  </section>
</Landing>
