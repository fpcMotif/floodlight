---
import "../styles/tokens.css";
import "../styles/landing.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const base = import.meta.env.BASE_URL;
const root = `${base.replace(/\/$/, "")}/`;
const iconURL = `${root}app-icon.png`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const socialImage = new URL(iconURL, Astro.site ?? Astro.url).href;

const repository =
  import.meta.env.PUBLIC_GITHUB_REPOSITORY ??
  process.env.GITHUB_REPOSITORY ??
  "victorgarcia/floodlight";
const repositoryURL = `https://github.com/${repository}`;

const docs = (slug: string) => `${root}${slug}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={iconURL} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="The Floodlight app icon." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="The Floodlight app icon." />
  </head>

  <body>
    <a class="fl-skip" href="#main">Skip to content</a>

    <nav class="nav" aria-label="Primary">
      <div class="nav__inner">
        <a class="nav__brand" href={root}>
          <img class="nav__mark" src={iconURL} alt="" width="22" height="22" />
          Floodlight
        </a>
        <ul class="nav__links">
          <li><a href={docs("guides/search")}>Search</a></li>
          <li><a href={docs("guides/keyboard-shortcuts")}>Shortcuts</a></li>
          <li><a href={docs("reference/indexing")}>Indexing</a></li>
          <li class="nav__github">
            <a class="nav__icon-link" href={repositoryURL} aria-label="GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M12 0C5.37 0 0 5.5 0 12.28c0 5.42 3.44 10.01 8.21 11.63.6.11.82-.27.82-.59 0-.29-.01-1.06-.02-2.08-3.34.74-4.04-1.65-4.04-1.65-.55-1.42-1.34-1.8-1.34-1.8-1.09-.76.08-.75.08-.75 1.21.09 1.85 1.27 1.85 1.27 1.07 1.88 2.82 1.34 3.51 1.02.11-.79.42-1.34.76-1.64-2.67-.31-5.47-1.36-5.47-6.08 0-1.34.47-2.44 1.24-3.3-.12-.31-.54-1.57.12-3.26 0 0 1.01-.33 3.3 1.26.96-.27 1.98-.41 3-.42 1.02.01 2.04.15 3 .42 2.29-1.59 3.3-1.26 3.3-1.26.66 1.69.24 2.95.12 3.26.77.86 1.24 1.96 1.24 3.3 0 4.73-2.81 5.76-5.49 6.07.43.38.82 1.13.82 2.27 0 1.64-.02 2.96-.02 3.36 0 .33.22.71.83.59C20.56 22.28 24 17.69 24 12.28 24 5.5 18.63 0 12 0Z"
                />
              </svg>
            </a>
          </li>
          <li class="nav__keep">
            <a class="nav__cta" href={docs("getting-started/quickstart")}>Get started</a>
          </li>
        </ul>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap wrap--wide">
        <div class="foot__cols">
          <div>
            <p class="foot__h">Get started</p>
            <ul>
              <li><a href={docs("getting-started/quickstart")}>Quickstart</a></li>
              <li><a href={docs("getting-started/install")}>Install &amp; permissions</a></li>
              <li><a href={docs("getting-started/replace-spotlight")}>Replace Spotlight</a></li>
            </ul>
          </div>
          <div>
            <p class="foot__h">Using Floodlight</p>
            <ul>
              <li><a href={docs("guides/search")}>Search</a></li>
              <li><a href={docs("guides/filters")}>Filters</a></li>
              <li><a href={docs("guides/keyboard-shortcuts")}>Keyboard shortcuts</a></li>
            </ul>
          </div>
          <div>
            <p class="foot__h">Reference</p>
            <ul>
              <li><a href={docs("reference/indexing")}>Indexing</a></li>
              <li><a href={docs("reference/troubleshooting")}>Troubleshooting</a></li>
            </ul>
          </div>
          <div>
            <p class="foot__h">Project</p>
            <ul>
              <li><a href={docs("development/building")}>Build from source</a></li>
              <li><a href={repositoryURL}>GitHub</a></li>
            </ul>
          </div>
        </div>

        <div class="foot__legal">
          <span>Floodlight is open source under the MIT License.</span>
        </div>
      </div>
    </footer>

    <script>
      const light = document.querySelector<HTMLElement>("[data-light]");
      document.addEventListener("fl:query", (event) => {
        const { length } = (event as CustomEvent<{ length: number }>).detail;
        light?.style.setProperty("--beam", String(Math.min(length / 6, 1)));
      });

    </script>
  </body>
</html>
